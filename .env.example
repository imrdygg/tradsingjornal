# GEMINI_API_KEY: Required for the AI coach (api/coach.ts).
#
# This is a SERVER secret. Do NOT prefix it with VITE_: Vite inlines every VITE_
# variable into the JavaScript bundle, which would make the key readable by anyone
# who opens devtools on the deployed site.
#
# Set it in the host's environment variables (e.g. Vercel -> Settings -> Environment
# Variables) and redeploy. The api/ folder is deployed as a serverless function, and
# that is the only place this key is read. Local `npm run dev` does not serve
# serverless functions, so the Coach tab reports itself unavailable there; use
# `vercel dev` to test the coach locally.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. The first model tried. If it is unavailable the endpoint falls
# back through gemini-flash-lite-latest, gemini-flash-latest, gemini-3.6-flash and
# gemini-2.5-flash-lite, because the newest models are frequently overloaded (503) and
# older ones get retired for new accounts.
#
# Tip: `npm run verify:coach` reads this file and makes one real call, reporting which
# model answered. On the deployed site, GET /api/coach returns the same information.
# GEMINI_MODEL="gemini-flash-lite-latest"

# MARKET DATA: No key needed. The plan-lock preview heat map (api/market.js) fetches
# the 11 US sector ETFs + SPY from Yahoo's public chart API, keyless, cached 60s
# server-side. GET /api/market?symbol=MES returns a live read of one futures contract
# (MES=F, MNQ=F, ...) for the plan panel, cached 20s. If Yahoo blocks or changes the
# endpoint, the heat map, the live price and the coach's market opinions all degrade
# gracefully — the plan can still be locked and every field is still editable by hand.

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase: Optional. When both values below are set, the app requires a login
# and syncs your journal to the cloud. Without them it runs as a local-only journal.
# Find these in the Supabase dashboard under Project Settings -> API.
# Local development uses .env.local (gitignored).
#
# Video attachments need these credentials: uploads go to the public
# "journal-media" Storage bucket. Run supabase/schema.sql once to create it.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"
