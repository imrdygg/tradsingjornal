{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:chart-patterns": "vite --config vite.chart-patterns.config.ts --port=3001 --strictPort",
    "build": "vite build",
    "build:chart-patterns": "vite build --config vite.chart-patterns.config.ts",
    "preview:chart-patterns": "vite preview --config vite.chart-patterns.config.ts --port=4174 --strictPort",
    "e2e:product": "npm run build:chart-patterns && playwright test --config playwright.product.config.ts",
    "dev:mes": "vite --config vite.mes-tracker.config.ts --port=3002 --strictPort",
    "build:mes": "vite build --config vite.mes-tracker.config.ts",
    "preview:mes": "vite preview --config vite.mes-tracker.config.ts --port=4175 --strictPort",
    "e2e:mes": "npm run build:mes && playwright test --config playwright.mes.config.ts",
    "check:boundaries": "tsx scripts/check-product-boundaries.ts",
    "package:chart-patterns": "npm run build:chart-patterns && tsx scripts/package-product.ts products/chart-patterns",
    "package:mes": "npm run build:mes && tsx scripts/package-product.ts products/mes-tracker",
    "build:function": "tsx scripts/bundle-coach.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "e2e": "playwright test",
    "verify:coach": "tsx scripts/check-coach.ts",
    "verify:memory": "tsx scripts/check-memory-embedding.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.2",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
